extends ../layout

block content

  .topbar
    .topbar-title
      | Mis Referencias
      span Biblioteca personal
    a.btn.btn-primary(href='/referencias/nueva')
      | ＋ Nueva referencia

  .page-content

    if error
      .flash.flash-error= error
    if exito
      .flash.flash-success= exito

    script.
      window.AREAS_DATA = !{areasJSON};

    .card

      .card-header(style='flex-wrap:wrap;gap:.75rem')
        span.card-title
          | #{referencias.length} referencia#{referencias.length !== 1 ? 's' : ''}

        .d-flex.gap-2.align-items-center(style='flex-wrap:wrap')
          input#buscar.field-input(
            type='text'
            placeholder='Buscar título o autor...'
            style='width:200px'
            oninput='aplicarFiltros()'
          )
          select#filtro-area.field-select(
            style='width:165px'
            onchange='filtrarAreasLista(this.value)'
          )
            option(value='') 🏫 Todas las áreas
            each area in areas
              option(value=area.id_area)= area.nombre
          select#filtro-materia.field-select(style='width:165px' disabled onchange='filtrarMateriasLista(this.value)')
            option(value='') 📖 Todas las materias
          select#filtro-tema.field-select(style='width:165px' disabled onchange='aplicarFiltros()')
            option(value='') 📝 Todos los temas

      if referencias.length === 0
        .card-body.empty-state
          p Aún no tienes referencias registradas.
          a.btn.btn-primary(href='/referencias/nueva') Agregar primera referencia

      else
        .table-wrap
          table.ref-table#tabla-refs
            thead
              tr
                th Título
                th Tipo
                th Autores
                th Temas
                th Año
                th Acciones
            tbody
              each ref in referencias
                - const temaIds    = (ref.temas || []).map(t => t.id_tema).join(',')
                - const materiaIds = (ref.temas || []).map(t => t.materia ? t.materia.id_materia : '').filter(Boolean).join(',')
                - const areaIds    = (ref.temas || []).map(t => t.materia && t.materia.area ? t.materia.area.id_area : '').filter(Boolean).join(',')
                tr(
                  data-titulo=ref.titulo.toLowerCase()
                  data-autores=(ref.autors || []).map(a => a.apellido_paterno).join(' ').toLowerCase()
                  data-temas=temaIds
                  data-materias=materiaIds
                  data-areas=areaIds
                )
                  td
                    a(href=`/referencias/${ref.id_referencia}` style='color:var(--text);text-decoration:none;font-weight:600')
                      = ref.titulo
                    if ref.subtitulo
                      span(style='display:block;font-size:.74rem;color:var(--text-muted)') — #{ref.subtitulo}
                  td
                    - const tipo = ref.tipos_fuente ? ref.tipos_fuente.nombre : '—'
                    - const claseTipo = tipo === 'Libro' ? 'badge-libro' : tipo === 'Tesis' ? 'badge-tesis' : tipo === 'Artículo de Revista' ? 'badge-articulo' : 'badge-web'
                    span.badge-tipo(class=claseTipo)= tipo
                  td.muted
                    - const autores = ref.autors || []
                    if autores.length === 0
                      | —
                    else if autores.length === 1
                      | #{autores[0].apellido_paterno}, #{autores[0].nombres}
                    else
                      | #{autores[0].apellido_paterno} et al.
                  td
                    - const temas = ref.temas || []
                    if temas.length === 0
                      span(style='color:var(--text-muted);font-size:.75rem') —
                    else
                      .autor-list
                        each t in temas.slice(0,3)
                          span.autor-chip(style='font-size:.68rem')
                            if t.numero_tema
                              | #{t.numero_tema}. 
                            | #{t.nombre}
                        if temas.length > 3
                          span.autor-chip(style='font-size:.68rem;color:var(--text-muted)') +#{temas.length - 3} más
                  td.muted= ref.anio_publicacion || '—'
                  td
                    .action-group
                      a.btn.btn-secondary.btn-sm(href=`/referencias/${ref.id_referencia}`) Ver
                      a.btn.btn-gold.btn-sm(href=`/referencias/${ref.id_referencia}/citar`) Citar
                      a.btn.btn-secondary.btn-sm(href=`/referencias/${ref.id_referencia}/editar`) Editar
                      form(action=`/referencias/${ref.id_referencia}/eliminar` method='POST' style='margin:0' onsubmit="return confirm('¿Eliminar esta referencia?')")
                        button.btn.btn-danger.btn-sm(type='submit') Eliminar
